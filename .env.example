# Copy to .env: cp .env.example .env
# Full field list / defaults: src/mlms/config.py (pydantic-settings Settings class)
# Read by docker compose, the scripts, the tests and a server started from this directory.
# An MCP client that launches the server itself does not read it: put EMBEDDING_API_KEY in
# the client's config.

# --- Infrastructure ---------------------------------------------------------
# optional, default shown (matches docker-compose.yml dev credentials)
DATABASE_URL=postgresql+psycopg://mlms:mlms@localhost:5432/mlms
# optional, default shown
REDIS_URL=redis://localhost:6379/0

# --- Compose credentials (docker-compose.yml only, not read by the app) -----
# These configure the postgres service's own POSTGRES_* env vars and are not
# pydantic-settings fields (Settings has no postgres_user/password/db field,
# and extra="ignore" means the app silently ignores them if present) — keep
# them in sync with DATABASE_URL above if you change them.
# Changing POSTGRES_PASSWORD only takes effect on a fresh postgres_data volume
# (the image applies POSTGRES_* only at first init) — `docker compose down -v`
# or a manual ALTER ROLE is required to change it on an existing volume.
# Avoid `@ : / % #` in the password — it's not URL-encoded when composed into
# DATABASE_URL above.
# optional, default shown
POSTGRES_DB=mlms
# optional, default shown
POSTGRES_USER=mlms
# optional, default shown
POSTGRES_PASSWORD=mlms

# --- Embedding API -----------------------------------------------------------
# required (server starts without it, but embedding calls — memorize(),
# get_facts(about=...), search_memory() — will fail with 401 at first use)
#EMBEDDING_API_KEY=your-key-here
# optional, default shown
EMBEDDING_API_BASE=https://openrouter.ai/api/v1

# --- MCP transport -------------------------------------------------------------
# optional, default shown. stdio is the default MCP client-launches-subprocess
# mode, never checks MCP_SHARED_SECRET (no network port). sse/streamable-http off
# loopback require it — see docs/deployment.md, "Homelab/VPS hardening", first.
MCP_TRANSPORT=stdio
# optional, default shown
MCP_HOST=0.0.0.0
# optional, default shown
MCP_PORT=8000
# required for sse/streamable-http on a non-loopback MCP_HOST (server refuses to start
# without it there); optional on loopback. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Client sends it back as: Authorization: Bearer <value>
# docker-compose.yml's mlms service hardcodes MCP_HOST=0.0.0.0 (non-loopback) — with
# `docker compose --profile app up` the container refuses to start until this is set here.
#MCP_SHARED_SECRET=
